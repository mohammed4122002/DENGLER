# ---------------------------------------------------------------------------
# DENGLER environment
# Copy to .env.local and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Public site URL, used for canonical URLs / Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (optional) ---------------------------------------------------
# Leave these blank to run the platform in DEMO MODE, which serves the bundled
# seed catalogue from memory. Fill them in to persist to Postgres.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the admin dashboard for privileged writes.
# NEVER prefix this with NEXT_PUBLIC_ and never import it from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin access ----------------------------------------------------------
# Demo-mode gate for /admin. With Supabase configured, sign in with a Supabase
# user whose `role` claim (or profiles.role) is 'admin' instead.
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
